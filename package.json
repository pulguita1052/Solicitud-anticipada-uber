{
  "name": "solicitud-anticipada-uber",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "build:artifact": "tsc -b && VITE_ARTIFACT=1 vite build --outDir dist-artifact",
    "preview": "vite preview --host",
    "typecheck": "tsc -b --noEmit",
    "test:visual": "node tests/visual/run.mjs",
    "test:domain": "node --experimental-strip-types tests/domain/uber.test.mjs"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "pixelmatch": "^6.0.0",
    "playwright": "^1.47.2",
    "pngjs": "^7.0.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
